# Provider-neutral OASIS runtime paths and secrets. Copy values into your secret manager or
# process environment; never commit real credentials.
OASIS_DEVICE=cpu
OASIS_RUNTIME_ENGINE=auto
OASIS_MODEL_PROFILE=gemma4_e4b_it
OASIS_ARTIFACT_ROOT=/var/lib/oasis/artifacts
OASIS_RUN_ROOT=/var/lib/oasis/runs
OASIS_OFFLOAD_ROOT=/var/lib/oasis/offload
HF_HOME=/var/cache/huggingface

# Optional public UI sharing: install the [share] extra and pass --serve-ui --share.
# Export these in the process environment (this file is not loaded automatically).
# Gradio sharing needs no account or tunnel token.
# OASIS_SHARE_PASSWORD=your-private-password-at-least-12-characters
# Without OASIS_SHARE_PASSWORD, a random password is printed for each launch.

# Message-to-answer defaults. Users only need to supply their message.
OASIS_AGENT_WALL_TIME_MS=120000
OASIS_AGENT_TOTAL_TOKENS=512000
OASIS_AGENT_GENERATED_TOKENS=32768
OASIS_AGENT_GENERATION_TOKENS=2048
OASIS_AGENT_TOOL_CALLS=64
OASIS_AGENT_TOOL_ROUNDS=20
OASIS_AGENT_MODEL_TIMEOUT_SECONDS=60
# OASIS_AGENT_SYSTEM_PROMPT=Override the shared agent instructions here.
# OASIS_CATALOG_ENDPOINT=https://your-stac-catalog.example/api
# OASIS_PLACE_ENDPOINT=https://nominatim.openstreetmap.org
# OASIS_ROUTING_ENDPOINT=https://router.project-osrm.org

# Required only when exposing an OASIS model worker.
OASIS_MODEL_WORKER_AUTH_TOKEN=replace-with-a-random-secret

# Required only when a controller connects to an already provisioned model worker.
# OASIS_RUNTIME_ENGINE=remote
# OASIS_REMOTE_ENDPOINT=https://worker.example.test
# OASIS_REMOTE_AUTH_TOKEN=replace-with-the-worker-secret

# Local-only credential used by the Runpod launch/status/terminate commands.
# Put the real value in your shell, never in a tracked experiment TOML or image.
# RUNPOD_API_KEY=replace-with-a-runpod-api-key
